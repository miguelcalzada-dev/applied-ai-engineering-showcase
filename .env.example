# ============================================================
# AI Lab - Variables de Entorno
# Copia este archivo como .env y rellena tus valores reales.
# ============================================================

# Tu Google AI API Key (obligatorio)
# Consiguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Gemini a usar. Por defecto gemini-2.5-flash-lite (rapido y economico).
GEMINI_MODEL=gemini-2.5-flash-lite

# Modelo de embeddings para el modulo RAG.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Puerto de la aplicacion (opcional, por defecto 8000)
PORT=8000

# TTL de las sesiones en memoria (chat y RAG), en segundos.
# Las sesiones inactivas se purgan para evitar fugas de memoria.
SESSION_TTL_SECONDS=3600

# Rate limiting de la API, por IP.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_SECONDS=60
