# ============================================================
# AI Portfolio Demo — Variables de Entorno
# Copia este archivo como .env y rellena tus valores reales.
# ============================================================

# Tu Google AI API Key (obligatorio)
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Gemini a usar (opcional, por defecto gemini-2.5-pro)
# GEMINI_MODEL=gemini-2.5-pro

# Puerto de la aplicación (opcional, por defecto 8000)
# PORT=8000
